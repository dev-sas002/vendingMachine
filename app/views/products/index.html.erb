<table>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.name %></td>
        <td><%= product.available_amount.to_s %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @pagy && @pagy.pages > 1 %>
  <p>Page <%= @pagy.page %> of <%= @pagy.pages %></p>
<% end %>
