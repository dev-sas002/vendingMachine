SITE_TITLE=VendingMachine
SERVER_URL=
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=vending_machine
REDIS_URL=redis://localhost:6379
MAILER_DOMAIN=
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL_ADDRESS=no-reply@my-app.com
# Required in production only: HTTP basic auth for the Sidekiq web UI at
# /jobmonitor. There is deliberately no default - the initializer reads them
# with ENV.fetch and no fallback, so leaving them unset makes every request to
# /jobmonitor fail instead of succeeding with a guessable password.
JOB_MONITOR_USERNAME=
JOB_MONITOR_PASSWORD=
# Coin denominations the machine accepts. Leave unset for 5,10,20,50,100.
COIN_DENOMINATIONS=
# Connection pool size; defaults to RAILS_MAX_THREADS.
DB_POOL=
# Password given to the demo accounts created by `rails db:seed`.
SEED_PASSWORD=
